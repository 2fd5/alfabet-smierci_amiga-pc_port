routine sub_16CBA @ $16CBA
  call clear_text
  d5 = 0
  d5.b = $19
  call random
  if d0.w == 1 then
    a2 = $7AEDB  -- "Nie sądzę, żeby dalsze zabawianie tej osoby rozmową coś dało."
  elseif d0.w == 2 then
    a2 = $7AF19  -- "O nie! Koniec gadki! Czas działać!"
  elseif d0.w == 3 then
    a2 = $7AF3C  -- "Czy nie zabolały cię już struny głosowe?"
  elseif d0.w == 4 then
    a2 = $7AF65  -- "Dalsza rozmowa nic nie da. Spróbuj czegoś innego!"
  elseif d0.w == 5 then
    a2 = $7AF97  -- "Chyba nie chce już z tobą rozmawiać."
  elseif d0.w == 6 then
    a2 = $7AFBC  -- "Czy ty sobie wyobrażasz, że autorzy całe życie spędzili na układani..."
  elseif d0.w == 7 then
    a2 = $7B02E  -- "Znasz przysłowie o mowie i milczeniu? Pasuje do tej sytuacji jak ulał!"
  elseif d0.w == 8 then
    a2 = $7B075  -- "Dalsza rozmowa to strata twego cennego czasu! Daruj sobie, co?"
  elseif d0.w == 9 then
    a2 = $7B0B4  -- "No już, no już... Pogadasz sobie kiedy indziej..."
  elseif d0.b == $A then
    a2 = $7B0E6  -- "Gaduła z ciebie! Co za dużo to niezdrowo. "
  elseif d0.b == $B then
    a2 = $7B111  -- "Ty tu blebleble, a czas ucieka!"
  elseif d0.b == $C then
    a2 = $7B131  -- "Nie ma co strzępić języka! Może następnym razem..."
  elseif d0.b == $D then
    a2 = $7B164  -- "Mógłbyś powtórzyć? Chyba nie dotarło."
  elseif d0.b == $E then
    a2 = $7B18A  -- "Ty gadasz, a twój rozmówca ani me, ani be, ani kukuryku!"
  elseif d0.b == $F then
    a2 = $7B1C3  -- "Cicho!!! Słyszałeś ten dziwny zgrzyt w stacji dysków?"
  elseif d0.b == $10 then
    a2 = $7B1F9  -- "Nie ma sensu gonić spłoszonych saren (cytat)."
  elseif d0.b == $11 then
    a2 = $7B227  -- "Ależ zamknij się wreszcie!"
  elseif d0.b == $12 then
    a2 = $7B242  -- "Psssst! Jeszcze powiesz coś niestosownego!"
  elseif d0.b == $13 then
    a2 = $7B26D  -- "Ciszej! Właśnie zasnęło dziecko naszego grafika!"
  elseif d0.b == $14 then
    a2 = $7B29E  -- "Poruszaj ręką z większą gracją, kiedy wciskasz ten gadżet!"
  elseif d0.b == $15 then
    a2 = $7B2D9  -- "Nie reaguje! Chyba zostałeś zignorowany!"
  elseif d0.b == $16 then
    a2 = $7B302  -- "Znowu odzywasz się nie pytany! To nic nie da!"
  elseif d0.b == $17 then
    a2 = $7B330  -- "Wstań, spluń trzy razy przez lewe ramię i spróbuj ponownie"
  elseif d0.b == $18 then
    a2 = $7B36B  -- "Przelatujący właśnie samolot, zagłuszył to co powiedziałeś."
  else
    a2 = $7B3A7  -- "Dobra, dobra... ploty na poźniej!"
  end
  verb_talk = 0
  call print
  call draw_verb_bar
  call reset_verbs
  return
end

routine ui_panel @ $16E54
  call hit_test_ui
  if d3 == -1 then
    inv_click_armed = 1
  ::L16E6A::
    return
  end
  if d3 == 1 then
    if inv_click_armed == 1 then
      if lmb then
        if verb_give ~= 1 then
          if verb_use ~= 1 then
            goto L16E6A
          end
        ::L16EA0::
          call sub_19E10
          call draw_verb_bar
