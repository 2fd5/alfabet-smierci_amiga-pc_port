routine say @ $1C67E
  call clear_text
  call print
  call wait_right_click
  return
end

routine clear_print @ $1C68C
  call clear_text
  call print
  return
end

routine say_restore_cursor @ $1C696
  call clear_text
  call print
  call wait_right_click
  call cursor_hand
  return
end

