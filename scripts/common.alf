routine quip_if_verb @ $16980
  if verb_talk ~= 1 then
    if verb_take ~= 1 then
      if verb_use ~= 1 then
        if verb_open ~= 1 then
          return
        end
      ::L169F4::
        d5 = 0
        d5.b = $14
        call random
        if d0.w == 1 then
          if quip_person ~= 1 then
            a2 = $7A930  -- "Przepraszam, ale wydaje mi się, że miałeś już dzisiaj lepsze pomysły."
          else
            a2 = $7ABDF  -- "Chyba nie jesteś sadystą?"
          end
        elseif d0.w == 2 then
          if quip_person ~= 1 then
            a2 = $7A976  -- "Musisz być chyba bardzo zdesperowany."
          else
            a2 = $7ABF9  -- "Chciałbyś, tego... no..."
          end
        elseif d0.w == 3 then
          if quip_person ~= 1 then
            a2 = $7A99C  -- "Nie wydaje mi się to zbyt sensowne."
          else
            a2 = $7AC12  -- "Co ty! Przecież to nie jest przedmiot..."
          end
        elseif d0.w == 4 then
          if quip_person ~= 1 then
            a2 = $7A9C0  -- "Pudło!!!"
          else
            a2 = $7AC3B  -- "Pomyłka!"
          end
        elseif d0.w == 5 then
          if quip_person ~= 1 then
            a2 = $7A9C9  -- "Usiądź na chwilę i pomyśl."
          else
            a2 = $7AC44  -- "Zwariowałeś!?!"
          end
        elseif d0.w == 6 then
          if quip_person ~= 1 then
            a2 = $7A9E4  -- "Chyba nie to miałeś na myśli!"
          else
            a2 = $7AC53  -- "Ciekawe czy tak samo traktujesz swego szefa?"
          end
        elseif d0.w == 7 then
          if quip_person ~= 1 then
            a2 = $7AA02  -- "Zaskakujesz mnie..."
          else
            a2 = $7AC80  -- "A fe! A fe! Niegrzeczny chłopczyk!"
          end
        elseif d0.w == 8 then
          if quip_person ~= 1 then
            a2 = $7AA16  -- "A wystarczy pomyśleć..."
          else
            a2 = $7ACA3  -- "Nawet o tym nie myśl."
          end
        elseif d0.w == 9 then
          if quip_person ~= 1 then
            a2 = $7AA2E  -- "Przepraszam, ale to chyba nie to."
          else
            a2 = $7ACB9  -- "Ależ to nie jest po krasnoludzku!"
          end
        elseif d0.w == $A then
          if quip_person ~= 1 then
            a2 = $7AA50  -- "Wydaje mi się, że chodzi tu o co innego."
          else
          ::L16B5E::
            a2 = $7ACDB  -- "Nie rób scen!"
          end
        elseif d0.w == $B then
          if quip_person ~= 1 then
            a2 = $7AA79
          else
            a2 = $7ACE9  -- "Bez chwytów poniżej pasa, dobrze?"
          end
        elseif d0.w == $C then
          if quip_person ~= 1 then
            a2 = $7AA88  -- "Dlaczego tak?"
          else
            a2 = $7AD0B  -- "Łapy precz! To poważna gra a tobie się figli zachciewa!"
          end
        elseif d0.w == $D then
          if quip_person ~= 1 then
            a2 = $7AA96  -- "Nie ma jak klikać na co popadnie. Zgadłem?"
          else
            a2 = $7AD43  -- "Nic z tego! Nie radzę ci tego robić ani z tą osobą ani z innymi."
          end
        elseif d0.w == $E then
          if quip_person ~= 1 then
            a2 = $7AAC1  -- "Może niepotrzebnie kupowałeś przygodowkę?"
          else
            a2 = $7AD84  -- "Uch! Zawsze znajdzie się jakiś niewyżyty! Fuj!"
          end
        elseif d0.w == $F then
          if quip_person ~= 1 then
            a2 = $7AAEB  -- "Założę się, że tego nie przemyślałeś."
          else
            a2 = $7ADB3  -- "No coś podobnego! Można mieć odchyły, ale żeby tak? Dewiant!"
          end
        elseif d0.w == $10 then
          if quip_person ~= 1 then
            a2 = $7AB11  -- "Tylko na to cię stać? Wstyd!"
          else
            a2 = $7ADF0  -- "Czy naprawdę tego chcesz?"
          end
        elseif d0.w == $11 then
          if quip_person ~= 1 then
            a2 = $7AB2E  -- "Pokombinuj trochę... Tym razem nic z tego."
          else
            a2 = $7AE0A  -- "Weź zimny prysznic! Podobno pomaga!"
          end
        elseif d0.w == $12 then
          if quip_person ~= 1 then
            a2 = $7AB59  -- "Spróbuj inaczej! Rozwiązanie jest tak blisko!"
          else
            a2 = $7AE2E  -- "To jest gra przygodowa, lecz nie mieliśmy na myśli takich przygód."
          end
        elseif d0.w == $13 then
          if quip_person ~= 1 then
            a2 = $7AB87  -- "Nie ma czasu na takie eksperymenty! Zrób coś innego!"
          else
            a2 = $7AE71  -- "Pomyśl o etycznym wymiarze tego co chcesz zrobić."
          end
        elseif quip_person ~= 1 then
          a2 = $7ABBC  -- "To był całkowicie chybiony pomysł."
        else
          goto L16B5E
        end
        return
      end
      goto L169F4
    end
    goto L169F4
  end
  goto L169F4
end

