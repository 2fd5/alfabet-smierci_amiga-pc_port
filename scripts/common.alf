routine game_over @ $13E92
  call music_stop
  music_order = $3D
  call music_start
  d5 = 0
  d5.b = 4
  call random
  if d0.w == 1 then
    call loc_02_2
    jump sub_142CA
  end
  if d0.w == 2 then
    call loc_02
    jump sub_142CA
  end
  if d0.w == 3 then
    call loc_08_2
    jump sub_142CA
  end
  call loc_07_2
  jump sub_142CA
end

