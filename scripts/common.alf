  call clear_text
  call print
  call cursor_hand
  return
end

routine text_white @ $1C6B6
  a0 = $59AEC
  w[a0] = $FFF
  w[a0+$8] = $FFF
  return
end

routine sub_1C8F6 @ $1C8F6
  d6.w = $32
::L1C8FA::
  wait_raster $E0
  d6.w -= 1
  if d6.w ~= -1 then goto L1C8FA end
  return
end

routine sub_4E6E4 @ $4E6E4
::L4E6E4::
  d0 = 0
  d1 = 0
  d2 = 0
  d3 = 0
  d0.b = vhpos
  d1.b = b[$DFF007]
  d2.b = b[$DFF008]
  d3.b = b[$DFF026]
  ext d0.w
  ext d3.w
  mulu d0, d3.w
  d0.b += d2.b
  ext d0
  ext d1.w
  d1.w += 2
  divu d0, d1.w
  if d0.w ~= 0 then
  else
    goto L4E6E4
  end
  w[$4E82C] = d0.w
  return
end

routine sub_4E8B4 @ $4E8B4
  d6 = 0
  d3 = 0
  d6 = $4EA16
  d3 = $1600
  call native_4E92A
  call native_4E98E
  call native_4E962
  return
end

routine sub_4E8D8 @ $4E8D8
  d6 = 0
  d3 = 0
  d6 = $4EA16
  d3 = $1600
  call native_4E92A
  call native_4E9AE
  call native_4E962
  jump restore_after_load
end

routine sub_4ED24 @ $4ED24
  call clear_disk_band
  a2 = $7FB33  -- " /  /       Włóż Dysk Stanu Gry"
  call print_alt
  w[$4F80E] = 0
  l[$5787A] = 0
::L4ED42::
  w[$4F810] = 0
  l[$4F81E] = $5787A
  w[$4F822] = 0
  w[$4F824] = 1
  w[$4F826] = 0
  w[$4F814] = 0
  w[$4F812] = $4489
  call native_4F232
  if w[$4F818] == 0 then
  else
    goto L4ED42
  end
  if l[$5787A] ~= $5354414E then
    goto L4ED42
  end
  call clear_disk_band
  a2 = $7FB81
  call print_alt
  w[$4F810] = 0
  l[$4F81E] = $7C90C
  w[$4F822] = 1
  w[$4F824] = 1
  w[$4F826] = 0
  w[$4F814] = 0
  w[$4F812] = $4489
  call native_4F232
  if w[$4F818] ~= 0 then
    call clear_disk_band
    a2 = $7FBBB
    call print_alt
  ::L4EDFE::
    if lmb then
    else
      goto L4EDFE
    end
  end
  return
end

routine sub_4EE0A @ $4EE0A
  call clear_disk_band
  a2 = $7FB33  -- " /  /       Włóż Dysk Stanu Gry"
  call print_alt
  w[$4F80E] = 0
  l[$5787A] = 0
::L4EE28::
  w[$4F810] = 0
  l[$4F81E] = $5787A
  w[$4F822] = 0
  w[$4F824] = 1
  w[$4F826] = 0
  w[$4F814] = 0
  w[$4F812] = $4489
  call native_4F232
  if w[$4F818] == 0 then
  else
    goto L4EE28
  end
  if l[$5787A] ~= $5354414E then
    goto L4EE28
  end
::L4EE7C::
  call clear_disk_band
  a2 = $7FB9E
  call print_alt
  w[$4F810] = 0
  l[$4F81E] = $7C90C
  w[$4F822] = 1
  w[$4F824] = 1
  w[$4F826] = 0
  w[$4F814] = 0
  w[$4F812] = $4489
  call native_4F2B8
  if w[$4F818] ~= 0 then
    call clear_disk_band
    a2 = $7FBBB
    call print_alt
  ::L4EEE4::
    if lmb then
    else
      goto L4EEE4
    end
  end
  call native_4F026
  if bit(ciaa_pra, 3) == 0 then
    call clear_disk_band
    a2 = $7FC1E  -- " /  /  Odbezpiecz dysk i naciśnij prawy klawisz myszki!"
    call print_alt
    call wait_right_click_fast
    goto L4EE7C
  end
  call native_4F044
  return
end

