routine loc_20 @ $0BBDE
::L0BBDE::
  loc_id = $20
  call select_music
  call clear_text
  call draw_verb_bar
  call cursor_off
  call reset_verbs
  call ensure_disk
  a0 = $15E87A
  a1 = $610FE
  call decrunch
  call show_frame
  if b[$7C15E] == 0 then
    call sub_1B09C
  end
  call sub_1BC82
  call cursor_hand
  hotspot_table = $1D36C
  mouse_min_y = $20
  mouse_max_y = $253
  mouse_max_x = $27A
  call clear_text
  call draw_verb_bar
  call reset_verbs
::L0BC72::
  wait_raster $FF
  call ui_panel
  call ui_combine
  call hit_test
  if d2 == -1 then
    call cursor_hand
    hover_mode = 1
    if label_shown == 1 then
      call clear_text
      goto L0BC72
    end
    goto L0BC72
  end
  if d2 == 1 then
    if hover_mode == 1 then
      call clear_text
      a2 = $82699  -- "Do studni"
      call print
      call label_mode
    end
    call cursor_anim_cd88
    if lmb then
      w[$7C246] = 0
      w[$7C202] = 0
      call sub_1BC92
      goto L0B558
    end
    goto L0BC72
  end
  if d2 == 2 then
    if b[$7C15E] == 1 then
      if lmb then
        call cursor_busy
        quip_person = 0
        if hover_mode == 1 then
          if verb_take == 1 then
            call sub_1B09C
            l[$1932A] = $7B972  -- "  pistolet  "
            call inventory_add
            l[$1932E] = $7DFB4
            call inventory_remove
            b[$7C15E] = 0
            call reset_verbs
            goto L0BC72
          end
          if verb_look == 1 then
            a2 = $826AC  -- "Rzeźniczy pistolet do zabijania zwierząt. Pusty."
          else
            a2 = $826A3  -- "Pistolet"
            call quip_if_verb
          end
          call clear_text
          call print
          call reset_verbs
          goto L0BC72
        end
        goto L0BC72
      end
      goto L0BC72
    end
    goto L0BC72
  end
  if d2 == 3 then
    if lmb then
      call cursor_busy
      quip_person = 1
      if hover_mode == 1 then
        if verb_talk == 1 then
          call sub_16CBA
          call reset_verbs
          goto L0BC72
        end
        if verb_use == 1 then
          if w[$7C246] ~= 1 then
            if w[$7C246] == 2 then
              call sub_1BC92
              call sub_14360
              call clear_text
              a2 = $8273B  -- "    Sarna zniknęła i zobaczyłeś Córkę Gerwazego. / Teraz wreszcie M..."
              call print_alt
              call sub_1C006
              call wait_right_click_fast
              call sub_1C016
              b[$19328] = 1
              l[$1932A] = $7B972  -- "  pistolet  "
              call inventory_scroll_up
              l[$1932E] = $7DFB4
              call inventory_scroll_down
              l[$1932A] = $7BAD6  -- "  okulary   "
              call inventory_add
              l[$1932E] = $7DFEC
              call inventory_remove
              b[$19328] = 0
              call draw_inventory
              b[$7C16C] = 0
              call reset_verbs
              b[$7C0EC] = 1
              goto L0B558
            end
          ::L0BEE6::
            if verb_look == 1 then
              a2 = $826E5  -- "Sarenka! Ciekawe skąd się tu wzięła? Kogoś mi przypomina..."
            else
              a2 = $826DD  -- "Sarenka"
              call quip_if_verb
            end
          ::L0BF04::
            call clear_text
            call print
            call reset_verbs
            goto L0BC72
          end
          call draw_verb_bar
          w[$7C246] = 0
          a2 = $82721  -- "Niestety nie jest nabity."
          goto L0BF04
        end
        goto L0BEE6
      end
      goto L0BC72
    end
    goto L0BC72
  end
  goto L0BC72
end
