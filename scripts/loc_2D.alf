routine loc_2D @ $0F91A
::L0F91A::
  loc_id = $2D
  call select_music
  call clear_text
  call draw_verb_bar
  call cursor_off
  call reset_verbs
  call ensure_disk
  a0 = $1B45D6
  a1 = $610FE
  call decrunch
  call show_frame
  if b[$7C0FF] ~= 1 then
    call sub_1A70C
  elseif b[$7C13D] == 0 then
    call sub_1A70C
  end
  call sub_1BDC6
  call cursor_hand
  hotspot_table = $1D526
  mouse_min_y = $20
  mouse_max_y = $253
  mouse_max_x = $27A
  call clear_text
  call draw_verb_bar
  call reset_verbs
::L0F9C2::
  wait_raster $FF
  call ui_panel
  if b[$7C101] == 1 then
    if b[$7C0FD] ~= 1 then
      d6 = 0
      d6.b = ciaa_pra
      if bit(d6.b, 7) == 0 then
        w[$59AD8] = $FFF
        call sub_1A6C4
        b[$7C0FF] = 1
        a2 = $7E13B  -- "Wyzwoliłeś moc!!!"
        call clear_text
        call print
        call delay_200
        w[$59AD8] = 0
        b[$7C0FD] = 1
      end
    end
  end
  call ui_combine
  call hit_test
  if d2 == -1 then
    call cursor_hand
    hover_mode = 1
    if label_shown == 1 then
      call clear_text
      goto L0F9C2
    end
    goto L0F9C2
  end
  if d2 == 1 then
    if b[$7C0FF] == 1 then
      if b[$7C13D] == 1 then
        if lmb then
          call cursor_busy
          quip_person = 0
          if hover_mode == 1 then
            if verb_take == 1 then
              call sub_1A70C
              l[$1932A] = $7B477  -- "   klocek   "
              call inventory_add
              l[$1932E] = $7DF30
              call inventory_remove
              b[$7C13D] = 0
              b[$7C10E] += 1
              call reset_verbs
              goto L0F9C2
            end
            if verb_look == 1 then
              a2 = $837E1  -- "Klocek... To chyba część układanki. Ma jedną wypustkę z prawej i z ..."
            else
              a2 = $837CF  -- "Kawałek układanki"
              call quip_if_verb_b
            end
            call clear_text
            call print
            call reset_verbs
            goto L0F9C2
          end
          goto L0F9C2
        end
        goto L0F9C2
      end
      goto L0F9C2
    end
    goto L0F9C2
  end
  if d2 == 2 then
    if lmb then
      call cursor_busy
      quip_person = 0
      if hover_mode == 1 then
        if verb_use == 1 then
          a2 = $83884  -- "Skaczę! Ciekawe czy woda jest ciepła!"
          call say
          call clear_text
          b[$7C106] = 1
          b[$7C126] = 1
          call sub_1BDD6
          goto L082FC
        end
        if verb_look == 1 then
          a2 = $8384C  -- "Przez tę dziurę widać jakiś niewyraźny kształt w wodzie"
          call say
          call clear_text
          b[$7C106] = 0
          call sub_1BDD6
          goto L082FC
        end
        a2 = $8382A  -- "Dziura w poręczy z prawej strony."
        call quip_if_verb
        call clear_text
        call print
        call reset_verbs
        goto L0F9C2
      end
      goto L0F9C2
    end
    goto L0F9C2
  end
  if d2 == 3 then
    if hover_mode == 1 then
      call clear_text
      a2 = $838AA  -- "Na targ"
      call print
      call label_mode
    end
    call cursor_exit_a
    if lmb then
      call sub_1BDD6
      goto L0DA7A
    end
    goto L0F9C2
  end
  if d2 == 4 then
    if hover_mode == 1 then
      call clear_text
      a2 = $838B2  -- "Do lasu"
      call print
      call label_mode
    end
    call cursor_exit_b
    if lmb then
      call sub_1BDD6
      goto L11C06
    end
    goto L0F9C2
  end
  goto L0F9C2
end
