routine loc_2E @ $0FC78
::L0FC78::
  loc_id = $2E
  call select_music
  call clear_text
  call draw_verb_bar
  call cursor_off
  call reset_verbs
  call ensure_disk
  a0 = $1100F6
  a1 = $610FE
  call decrunch
  call show_frame
  call sub_1BDEA
  call cursor_hand
  hotspot_table = $1D548
  mouse_min_y = $20
  mouse_max_y = $253
  mouse_max_x = $27A
  call clear_text
  call draw_verb_bar
  call reset_verbs
::L0FCFC::
  wait_raster $FF
  call ui_panel
  call ui_combine
  call hit_test
  if d2 == -1 then
    call cursor_hand
    hover_mode = 1
    if label_shown == 1 then
      call clear_text
      goto L0FCFC
    end
    goto L0FCFC
  end
  if d2 == 1 then
    if lmb then
      call cursor_busy
      quip_person = 0
      if hover_mode == 1 then
        if verb_look == 1 then
          a2 = $838C1  -- "Jest na nim tabliczka z napisem "QUEFRETE XANG" - magia, przepowiad..."
        else
          a2 = $838BA  -- "Domek."
          call quip_if_verb_b
        end
        call clear_text
        call print
        call reset_verbs
        goto L0FCFC
      end
      goto L0FCFC
    end
    goto L0FCFC
  end
  if d2 == 2 then
    if hover_mode == 1 then
      call clear_text
      a2 = $83916  -- "Do lasu"
      call print
      call label_mode
    end
    call cursor_exit_b
    if lmb then
      call sub_1BDFA
      goto L11C06
    end
    goto L0FCFC
  end
  if d2 == 3 then
    if hover_mode == 1 then
      call clear_text
      a2 = $8391E  -- "Strach na wróble"
      call print
      call label_mode
    end
    call cursor_anim_cd2c
    if lmb then
      call sub_1BDFA
      goto L10880
    end
    goto L0FCFC
  end
  if d2 == 4 then
    if b[$7C12D] ~= 1 then
      if hover_mode == 1 then
        call clear_text
        a2 = $8392F  -- "Do domku"
        call print
        call label_mode
      end
      call cursor_anim_cd88
      if lmb then
        call sub_1BDFA
        goto L0FE8C
      end
      goto L0FCFC
    end
    goto L0FCFC
  end
  goto L0FCFC
end
