config_description=Alfabet Smierci - original Amiga AGA reference (A1200, AROS ROM)
use_gui=no
kickstart_rom_file=:AROS
chipset=aga
chipset_compatible=A1200
cpu_type=68ec020
cpu_model=68020
cpu_24bit_addressing=true
cpu_speed=real
cpu_compatible=true
chipmem_size=4
fastmem_size=0
bogomem_size=0
z3mem_size=0
nr_floppies=1
floppy0type=0
floppy_speed=100
sound_output=exact
sound_frequency=48000
gfx_width_windowed=1280
gfx_height_windowed=1024
gfx_lores_mode=normal
gfx_resolution=hires
gfx_linemode=double
gfx_center_horizontal=simple
gfx_center_vertical=simple
win32.inactive_pause=false
win32.inactive_nosound=true
win32.minimized_pause=false
win32.minimized_nosound=true
win32.inactive_input=0
