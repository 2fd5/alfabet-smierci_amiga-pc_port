routine loc_0A @ $05A62
::L05A62::
  loc_id = $A
  call select_music
  call clear_text
  call draw_verb_bar
  call cursor_off
  call reset_verbs
  call ensure_disk
  a0 = $1444DE
  a1 = $610FE
  call decrunch
  call show_frame
  call sub_1B96A
  call cursor_hand
  hotspot_table = $1D036
  mouse_min_y = $20
  mouse_max_y = $253
  mouse_max_x = $27A
::L05AD4::
  wait_raster $FF
  call ui_panel
  call ui_combine
  call hit_test
  if d2 == -1 then
    call cursor_hand
    hover_mode = 1
    if label_shown == 1 then
      call clear_text
      goto L05AD4
    end
    goto L05AD4
  end
  if d2 == 1 then
  else
    if d2 == 2 then
      goto L05AD4
    end
    if d2 == 3 then
      if lmb then
        call cursor_busy
        quip_person = 0
        if hover_mode == 1 then
          if verb_look == 1 then
            a2 = $80360  -- "Wspaniałe miejsce na obserwatorium astronomiczne..."
          else
            a2 = $80359  -- "Dziura"
            call quip_if_verb
          end
          call clear_text
          call print
          call reset_verbs
          goto L05AD4
        end
        goto L05AD4
      end
      goto L05AD4
    end
    if d2 == 4 then
      if lmb then
        call cursor_busy
        quip_person = 0
        if hover_mode == 1 then
          if verb_look == 1 then
            a2 = $8039B  -- "Zamknięte na głucho. Wygląda jakby nikt tu nie mieszkał od lat."
          else
            a2 = $80394  -- "Furtka"
            call quip_if_verb
          end
          call clear_text
          call print
          call reset_verbs
          goto L05AD4
        end
        goto L05AD4
      end
      goto L05AD4
    end
    goto L05AD4
  end
  if hover_mode == 1 then
    call clear_text
    a2 = $8034F  -- "Do miasta"
    call print
    call label_mode
  end
  call cursor_anim_cd88
  if lmb then
  else
    goto L05AD4
  end
  call sub_1B97A
  goto L0390A
end
