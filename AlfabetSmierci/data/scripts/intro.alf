routine intro_sub_03504 @ $03504
  d7.w = $2B7
::IL03508::
  d6.w = $32
::IL0350C::
  wait_raster $F0
  if lmb then
  else
    d6.w -= 1
    if d6.w ~= -1 then goto IL0350C end
    d7.w -= 1
    if d7.w ~= -1 then goto IL03508 end
  end
  d7.w = $2B7
::IL0352E::
  d6.w = $32
::IL03532::
  wait_raster $F0
  if not lmb then
  else
    d6.w -= 1
    if d6.w ~= -1 then goto IL03532 end
    d7.w -= 1
    if d7.w ~= -1 then goto IL0352E end
  end
  return
end

routine intro_sub_03552 @ $03552
  d7 = l[$035B8]
::IL03558::
  d6.w = $18
::IL0355C::
  wait_raster $E0
  wait_raster $00
  if lmb then
  else
    d6.w -= 1
    if d6.w ~= -1 then goto IL0355C end
    d7.w -= 1
    if d7.w ~= -1 then goto IL03558 end
  end
  d7 = l[$035B8]
::IL0358A::
  d6.w = $18
::IL0358E::
  wait_raster $FF
  wait_raster $00
  if not lmb then
  else
    d6.w -= 1
    if d6.w ~= -1 then goto IL0358E end
    d7.w -= 1
    if d7.w ~= -1 then goto IL0358A end
  end
  return
end

routine intro_sub_035BC @ $035BC
  a0 = $2AFD0
  d7 = $5000
::IL035C8::
  l[a0++] = 0
  d7.w -= 1
  if d7.w ~= -1 then goto IL035C8 end
  return
end

routine intro_print @ $035D0
  push d0, d1, d2, d3, d4, d5, d6, d7, a0, a1, a2, a3, a4, a5, a6
  d0 = 0
  d1 = 0
  d2 = 0
  d3 = 0
  d2 = 4
  d3 += $730
::IL035E4::
  d0.b = b[a2++]
  if d0.b ~= 0 then
    if d0.b == $A then
      d3 += $320
      d2 = 4
      goto IL035E4
    end
    if d0.b == $B9 then
      goto IL035E4
    end
    if d0.b == $B2 then
      goto IL035E4
    end
    d1.w = d3.w
    d1 += d2
    call intro_sub_03618
    d2 += 1
    goto IL035E4
  end
  pop d0, d1, d2, d3, d4, d5, d6, d7, a0, a1, a2, a3, a4, a5, a6
  return
end

routine intro_sub_03618 @ $03618
  a0 = l[$2AFC6]
  d0.b -= $20
::IL03622::
  if d0.b u>= $50 then
    a0 += $280
    d0.b -= $50
    goto IL03622
  end
  a0 += d0
  a1 = $2AFD0
  d5.w = w[$0366A]
::IL03642::
  a1 += d1
  d7 = 7
::IL03646::
  d4.b = b[a0]
  b[a1] |= d4.b
  a0 += $50
  a1 += $50
  d7.w -= 1
  if d7.w ~= -1 then goto IL03646 end
  a0 -= $280
  d5.w -= 1
  if d5.w ~= -1 then goto IL03642 end
  return
end

routine intro_set_bitplanes @ $0366C
  a0 = l[$0369E]
  d0 = l[$036A6]
  d7 = l[$036A2]
::IL0367E::
  w[a0+$6] = d0.w
  swap d0
  w[a0+$2] = d0.w
  swap d0
  a0 = a0 + $8
  d0 += l[$0369A]
  d7.w -= 1
  if d7.w ~= -1 then goto IL0367E end
  return
end

routine intro_sub_036AA @ $036AA
  a1 = $3EBE
  a2 = $3ABE
  d7 = l[$038B6]
::IL036BC::
  l[a1++] = l[a0++]
  l[a2++] = 0
  d7.w -= 1
  if d7.w ~= -1 then goto IL036BC end
  return
end

routine intro_sub_036CA @ $036CA
  a0 = $761D0
