::IL03A64::
  d7 = l[$038BE]
::IL03A6A::
  d0 = 0
  d1 = 0
  d2 = 0
  d3 = 0
  d4 = 0
  d5 = 0
  d2.b = b[a0++]
  d2.b = b[a0++]
  d1.b = b[a0++]
  d0.b = b[a0++]
  d3.b = d0.b
  d4.b = d1.b
  d5.b = d2.b
  shr d3.b, 4
  d4.b &= $F0
  d5.b &= $F0
  shl d5.w, 4
  d5.b |= d3.b
  d5.b |= d4.b
  d0.b &= $F
  shl d1.b, 4
  d2.b &= $F
  shl d2.w, 8
  d2.b |= d0.b
  d2.b |= d1.b
  w[a1] = d5.w
