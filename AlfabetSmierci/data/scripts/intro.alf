routine intro_sub_038CA @ $038CA
  d5.w = $FE
::IL038CE::
  a0 = l[$038C2]
  a1 = l[$038C6]
  a2 = $3ABE
  a3 = $3EBE
  d6 = l[$038BA]
::IL038EC::
  d7 = l[$038BE]
::IL038F2::
  a4 = a2
  d0.b = b[a2++]
  d1.b = b[a3++]
  d0.b = b[a2++]
  d1.b = b[a3++]
  if d1.b ~= d0.b then
    d0.b += 1
    b[a2-$1] = d0.b
  end
  d0.b = b[a2++]
  d1.b = b[a3++]
  if d1.b ~= d0.b then
    d0.b += 1
    b[a2-$1] = d0.b
  end
  d0.b = b[a2++]
  d1.b = b[a3++]
  if d1.b ~= d0.b then
    d0.b += 1
    b[a2-$1] = d0.b
  end
  a0 += 4
  a1 += 4
  d7.w -= 1
  if d7.w ~= -1 then goto IL038F2 end
  a0 += $88
  a1 += $88
  d6.w -= 1
  if d6.w ~= -1 then goto IL038EC end
  call intro_palette_current_to_copper
  d5.w -= 1
  if d5.w ~= -1 then goto IL038CE end
  return
end

routine intro_sub_03944 @ $03944
  d5.w = $FE
::IL03948::
  a0 = l[$038C2]
  a1 = l[$038C6]
  a2 = $3EBE
  d6 = l[$038BA]
::IL03960::
  d7 = l[$038BE]
::IL03966::
  a4 = a2
  a2 += 1
  d0.b = b[a2++]
  if d0.b ~= 0 then
    d0.b -= 3
    if d0.b ~= $FF then
      if d0.b ~= $FE then
        b[a2-$1] = d0.b
      end
    end
  end
  d0.b = b[a2++]
  if d0.b ~= 0 then
    d0.b -= 3
    if d0.b ~= $FF then
      if d0.b ~= $FE then
        b[a2-$1] = d0.b
      end
    end
  end
  d0.b = b[a2++]
  if d0.b ~= 0 then
    d0.b -= 3
    if d0.b ~= $FF then
      if d0.b ~= $FE then
        b[a2-$1] = d0.b
      end
    end
  end
  a0 += 4
  a1 += 4
  d7.w -= 1
  if d7.w ~= -1 then goto IL03966 end
  a0 += $88
  a1 += $88
  d6.w -= 1
  if d6.w ~= -1 then goto IL03960 end
  call intro_palette_target_to_copper
  d5.w -= 1
  if d5.w ~= -1 then goto IL03948 end
  return
end

routine intro_palette_current_to_copper @ $039DA
  push d0, d1, d2, d3, d4, d5, d6, d7, a0, a1, a2, a3, a4, a5, a6
  a0 = $3ABE
  a1 = $299B4
  d6 = l[$038BA]
  a1 += 6
::IL039F2::
  d7 = l[$038BE]
::IL039F8::
  d0 = 0
  d1 = 0
  d2 = 0
  d3 = 0
  d4 = 0
  d5 = 0
  d2.b = b[a0++]
  d2.b = b[a0++]
  d1.b = b[a0++]
  d0.b = b[a0++]
  d3.b = d0.b
  d4.b = d1.b
  d5.b = d2.b
  shr d3.b, 4
  d4.b &= $F0
  d5.b &= $F0
  shl d5.w, 4
  d5.b |= d3.b
  d5.b |= d4.b
  d0.b &= $F
  shl d1.b, 4
  d2.b &= $F
  shl d2.w, 8
  d2.b |= d0.b
  d2.b |= d1.b
  w[a1] = d5.w
  w[a1+$84] = d2.w
  a1 += 4
  d7.w -= 1
  if d7.w ~= -1 then goto IL039F8 end
  a1 = a1 + $88
  d6.w -= 1
  if d6.w ~= -1 then goto IL039F2 end
  pop d0, d1, d2, d3, d4, d5, d6, d7, a0, a1, a2, a3, a4, a5, a6
  return
end

routine intro_palette_target_to_copper @ $03A4C
