  a1 += 4
  d7.w -= 1
  if d7.w ~= -1 then goto IL03A6A end
  a1 = a1 + $88
  d6.w -= 1
  if d6.w ~= -1 then goto IL03A64 end
  pop d0, d1, d2, d3, d4, d5, d6, d7, a0, a1, a2, a3, a4, a5, a6
  return
end
