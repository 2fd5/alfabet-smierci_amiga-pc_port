      a2 = $8DD96  -- "²- No właśnie... chciałem..."
      call say
      a2 = $8DDB3  -- "¹- No proszę! Już się nauczył! Chciałeś pewnie bajkę? To będzie tak..."
      call say
      a2 = $8DE0B
      call say
      a2 = $8DE16  -- "¹- Oto ona: "Siostra z bratem i mąż z żoną, cztery jabłka pod jabło..."
      call say
      a2 = $8DEA9  -- "²= Wiem! Siostra i brat to byli mąż i żona! / = Wiem! Brat się udła..."
      call show
