      a2 = $8D838  -- "¹- Nie? To może jesteś z mamą i tatą na letnisku? Bystry z ciebie c..."
      call say
      a2 = $8D884  -- "²- Nie jestem na żadnym letnisku!!!"
      call say
      a2 = $8D8A8  -- "¹- Hahahaha... Nie krzycz bo pan ściągnie pasa! Jak będziesz grzecz..."
      call say
      a2 = $8D90B  -- "²= Czy wy macie nierówno pod sufitem? Mam gdzieś wasz wierszyk! Dew..."
      call show
    ::L0D16C::
      wait_raster $FF
      if not lmb then
        if lmb then
        else
          goto L0D16C
        end
      end
      call hit_test
      if d2 ~= -1 then
      else
        goto L0D16C
      end
      if d2 u<= 4 then
      else
        goto L0D16C
