      a2 = $8DA30  -- "¹- No no no... Fantazję to on ma! Wprawdzie powinieneś dostać klaps..."
      call say
      a2 = $8DAC8
      call say
      a2 = $8DAD1  -- "¹- Tak, tak... Ta cywilizacja to naprawdę zaraza! Najgorsze to te k..."
      call say
      a2 = $8DB6C  -- "²- No taaak.."
      call say
      a2 = $8DB7A  -- "¹- No proszę. Od razu widać! Najgorsze są przygodówki! Nad taką to ..."
      call say
      a2 = $8DBFD  -- "²- Eeeerm..."
      call say
      a2 = $8DC0A  -- "¹- Raz to, proszę sobie wyobrazić pani Teresko, widziałam taką grę...."
      call say
      a2 = $8DCEB  -- "²- No właśnie...."
      call say
      a2 = $8DCFD  -- "¹- Oni gadali co chcieli, a jedyne możliwości odpowiedzi to jakieś ..."
